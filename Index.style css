/* ----------- Réinitialisation ----------- */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#0b0f19;
    color:white;
    scroll-behavior:smooth;
}

/* ----------- Navigation ----------- */

header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 8%;
    position:fixed;
    width:100%;
    background:rgba(11,15,25,.95);
    backdrop-filter:blur(10px);
    z-index:1000;
}

.logo h1{
    color:#4da3ff;
    letter-spacing:3px;
}

nav ul{
    list-style:none;
    display:flex;
    gap:25px;
}

nav a{
    color:white;
    text-decoration:none;
    transition:.3s;
}

nav a:hover{
    color:#4da3ff;
}

/* ----------- Accueil ----------- */

.hero{
    height:100vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:20px;
}

.hero h2{
    font-size:55px;
    margin-bottom:20px;
}

.hero p{
    font-size:22px;
    margin-bottom:40px;
    color:#cfcfcf;
}

.btn{
    text-decoration:none;
    color:white;
    background:#4da3ff;
    padding:15px 35px;
    border-radius:10px;
    transition:.3s;
}

.btn:hover{
    transform:scale(1.05);
}

/* ----------- Sections ----------- */

section{
    padding:100px 10%;
}

section h2{
    text-align:center;
    margin-bottom:50px;
    font-size:40px;
}

/* ----------- Cartes ----------- */

.cards{
    display:flex;
    justify-content:center;
    gap:30px;
    flex-wrap:wrap;
}

.card{
    background:#161c2c;
    width:320px;
    padding:30px;
    border-radius:15px;
    transition:.4s;
    text-align:center;
}

.card:hover{
    transform:translateY(-10px);
    box-shadow:0 0 25px rgba(77,163,255,.4);
}

.card h3{
    margin-bottom:20px;
}

.card p{
    margin-bottom:25px;
    line-height:1.6;
}

.card a{
    display:inline-block;
    text-decoration:none;
    color:white;
    background:#4da3ff;
    padding:12px 25px;
    border-radius:8px;
}

/* ----------- Vision ----------- */

#vision{
    text-align:center;
    line-height:1.8;
    font-size:20px;
}

/* ----------- Contact ----------- */

#contact{
    text-align:center;
}

/* ----------- Footer ----------- */

footer{
    background:#05070d;
    text-align:center;
    padding:30px;
    color:#999;
}

/* ----------- Responsive ----------- */

@media(max-width:900px){

header{
    flex-direction:column;
}

nav ul{
    margin-top:15px;
    flex-wrap:wrap;
    justify-content:center;
}

.hero h2{
    font-size:38px;
}

.hero p{
    font-size:18px;
}

}
